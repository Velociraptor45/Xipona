@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@using Fluxor
@using ProjectHermes.Xipona.Frontend.Redux.Shared.Actions.Settings
@using ProjectHermes.Xipona.Frontend.Redux.Shared.States

@inject IState<SharedState> State
@inject IDispatcher Dispatcher


<div class="background" @onclick="CloseSettings"></div>
<div class="settings-container px-2">
    <div class="top-bar">
        <div class="d-flex">
            <div class="settings-title">
                Settings
            </div>
            <div class="ml-auto mt-1">
                <i class="bi bi-x-lg" @onclick="CloseSettings"></i>
            </div>
        </div>
    </div>
    <div>
        <div>
            <div class="section-title">General</div>
            <hr/>
            <div>
                <div>
                    <div class="mr-2">Currency</div>
                    @if (State.Value.Settings.AllCurrencies.Count > 0)
                    {
                        <SingleSelect
                            Class="currency-select"
                            TItem="Currency"
                            TValue="int"
                            ValueName="@nameof(Currency.Id)"
                            LabelName="@nameof(Currency.Symbol)"
                            DataSource="@State.Value.Settings.AllCurrencies.ToList()"
                            OnItemChanged="OnCurrencyChanged"
                            Value="State.Value.Settings.GeneralSettings.Currency.Id">
                        </SingleSelect>
                    }
                    else
                    {
                        <div class="currency-skeleton"></div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="d-flex pb-2 mt-4">
        <Button Class="ml-auto" Size="ButtonSize.Default" Type="ButtonType.Primary" OnClick="Save">Save</Button>
    </div>
</div>

@code
{
    private void OnCurrencyChanged(Currency currency)
    {
        Dispatcher.Dispatch(new SelectedCurrencyChangedAction(currency));
    }

    private void CloseSettings()
    {
        Dispatcher.Dispatch(new CloseSettingsAction());
    }

    private void Save()
    {
    }
}
