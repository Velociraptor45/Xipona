@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@using Fluxor
@using ProjectHermes.Xipona.Frontend.Redux.Shared.Actions.Settings
@using ProjectHermes.Xipona.Frontend.Redux.Shared.States

@inject IState<SharedState> State
@inject IDispatcher Dispatcher

<Modal Title="Settings"
Visible="@State.Value.Settings.SettingsOpen"
OnCancel="CloseSettings"
Footer="GetFooter()">
    <div class="settings-container">
        <div>
            <div class="section-title">General</div>
            <hr/>
            <div>
                <div>
                    <div class="mr-2">Currency</div>
                    @if (State.Value.Settings.AllCurrencies.Count > 0)
                    {
                        <Select
                            Class="currency-select"
                            TItem="Currency"
                            TItemValue="int"
                            ValueName="@nameof(Currency.Id)"
                            LabelName="@nameof(Currency.Symbol)"
                            DataSource="@State.Value.Settings.AllCurrencies"
                            OnSelectedItemChanged="OnCurrencyChanged"
                            Value="State.Value.Settings.GeneralSettings.Currency.Id">
                        </Select>
                    }
                    else
                    {
                        <div class="currency-skeleton"></div>
                    }
                </div>
            </div>
        </div>
    </div>
</Modal>

@code
{
    private void OnCurrencyChanged(Currency currency)
    {
        Dispatcher.Dispatch(new SelectedCurrencyChangedAction(currency));
    }

    private void CloseSettings()
    {
        Dispatcher.Dispatch(new CloseSettingsAction());
    }

    private void Save()
    {
        Dispatcher.Dispatch(new SaveSettingsAction());
    }

    private RenderFragment GetFooter()
    {
        return @<Template>
            <Button Class="ml-auto"
                    OnClick="Save"
                    @key="@("submit")"
                    Type="@ButtonType.Primary"
                    Loading="@State.Value.Settings.IsSaving">
                Save
            </Button>
        </Template>;
    }
}
