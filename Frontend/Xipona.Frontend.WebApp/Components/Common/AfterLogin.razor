@using Fluxor
@using ProjectHermes.Xipona.Frontend.Redux.Shared.Actions
@using ProjectHermes.Xipona.Frontend.Redux.Shared.Ports
@using ProjectHermes.Xipona.Frontend.WebApp.Configs


@inject IApiClient ApiClient
@inject IShoppingListNotificationService NotificationService
@inject IDispatcher Dispatcher
@inject AuthConfig AuthConfig

@code
{
    protected override async Task OnInitializedAsync()
    {
        if (AuthConfig.Enabled)
        {
            try
            {
                var userInfo = await ApiClient.LoginAsync();
                Dispatcher.Dispatch(new UserLoggedInAction(userInfo));
            }
            catch (Exception e)
            {
                NotificationService.NotifyError("Login failed", "Login at the remote server failed: " + e.Message);
                return;
            }
        }

        await base.OnInitializedAsync();
    }
}
