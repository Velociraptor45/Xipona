@using Fluxor
@using Xipona.Frontend.Redux.ItemCategories.States
@using Xipona.Frontend.Redux.Items.Actions.Filter
@using Xipona.Frontend.Redux.Items.States

@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@inject IState<ItemState> State
@inject IDispatcher Dispatcher

<div>
    <div class="d-flex py-1">
        <div class="mr-2 align-self-center">
            Store
        </div>
        <Select DataSource="@State.Value.Stores.Stores"
                TItem="ItemStore"
                TItemValue="Guid"
                ValueName="@nameof(ItemStore.Id)"
                LabelName="@nameof(ItemStore.Name)"
                Value="@(State.Value.Search.Filter.SelectedStore?.Id ?? Guid.Empty)"
                OnSelectedItemChanged="OnStoreChanged"
                AllowClear="true">
        </Select>
    </div>
    <div class="d-flex py-1">
        <div class="mr-2 align-self-center">
            Category
        </div>
        <SingleSearchSelect Class="min-w-150"
                            TItem="ItemCategorySearchResult"
                            TValue="Guid"
                            DataSource="@State.Value.Search.Filter.ItemCategoryFilter.ItemCategories"
                            ValueName="@nameof(ItemCategorySearchResult.Id)"
                            LabelName="@nameof(ItemCategorySearchResult.Name)"
                            OnItemChanged="OnItemCategoriesChanged"
                            OnInputChanged="OnItemCategoryInputChanged"
                            Placeholder="Item Category"
                            Value="@(State.Value.Search.Filter.ItemCategoryFilter.SelectedItemCategory?.Id ?? Guid.Empty)"
                            SearchInput="@State.Value.Search.Filter.ItemCategoryFilter.Input"
                            OnDropdownClosed="OnItemCategoryDropdownClosed"
                            AllowClear="true">
        </SingleSearchSelect>
    </div>
    @* <div class="d-flex py-1"> *@
    @*     <div class="mr-2 align-self-center"> *@
    @*         Manufacturer *@
    @*     </div> *@
    @*     <Select Mode="tags" *@
    @*             DataSource="@State<>.Manufacturers.ToList()" *@
    @*             TItem="Manufacturer" *@
    @*             TItemValue="Guid" *@
    @*             ValueName="@nameof(Manufacturer.Id)" *@
    @*             LabelName="@nameof(Manufacturer.Name)" *@
    @*             @ref="@manufacturersSelectRef"></Select> *@
    @* </div> *@
    <Button @onclick="@OnLoadButtonClickedAsync" Disabled="@(!State.Value.Search.Filter.IsLoadButtonActive)">Load</Button>
</div>

@code {
    private void OnStoreChanged(ItemStore store)
    {
        Dispatcher.Dispatch(new SelectedStoreChangedAction(store));
    }
    
    private void OnItemCategoriesChanged(ItemCategorySearchResult itemCategory)
    {
        Dispatcher.Dispatch(new SelectedItemCategoryChangedAction(itemCategory));
    }
    
    private void OnItemCategoryInputChanged(string input)
    {
        Dispatcher.Dispatch(new ItemCategoryInputChangedAction(input));
    }
    
    private void OnItemCategoryDropdownClosed()
    {
        Dispatcher.Dispatch(new ItemCategoryDropdownClosedAction());
    }
    
    private void OnLoadButtonClickedAsync()
    {
        Dispatcher.Dispatch(new LoadFilteredItemsAction());
    }
}
