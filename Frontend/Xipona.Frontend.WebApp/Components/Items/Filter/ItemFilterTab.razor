@using Fluxor
@using Xipona.Frontend.Redux.ItemCategories.States
@using Xipona.Frontend.Redux.Items.Actions.Filter
@using Xipona.Frontend.Redux.Items.States
@using Xipona.Frontend.Redux.Manufacturers.States

@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@inject IState<ItemState> State
@inject IDispatcher Dispatcher

<div>
    <div class="selection-row">
        <div class="store w-100 max-w-200">
            <div>
                Store
            </div>
            <Select DataSource="@State.Value.Stores.Stores"
                    TItem="ItemStore"
                    TItemValue="Guid"
                    ValueName="@nameof(ItemStore.Id)"
                    LabelName="@nameof(ItemStore.Name)"
                    Value="@(State.Value.Search.Filter.SelectedStore?.Id ?? Guid.Empty)"
                    OnSelectedItemChanged="OnStoreChanged">
            </Select>
        </div>
        <div class="item-category w-100 max-w-200">
            <div>
                Category
            </div>
            <SingleSearchSelect Class="min-w-150"
                                TItem="ItemCategorySearchResult"
                                TValue="Guid"
                                DataSource="@State.Value.Search.Filter.ItemCategoryFilter.ItemCategories"
                                ValueName="@nameof(ItemCategorySearchResult.Id)"
                                LabelName="@nameof(ItemCategorySearchResult.Name)"
                                OnItemChanged="OnItemCategoryChanged"
                                OnInputChanged="OnItemCategoryInputChanged"
                                Placeholder="Item Category"
                                Value="@(State.Value.Search.Filter.ItemCategoryFilter.SelectedItemCategory?.Id ?? Guid.Empty)"
                                SearchInput="@State.Value.Search.Filter.ItemCategoryFilter.Input"
                                OnDropdownClosed="OnItemCategoryDropdownClosed"
                                AllowClear="true">
            </SingleSearchSelect>
        </div>
        <div class="manufacturer w-100 max-w-200">
            <div>
                Manufacturer
            </div>
            <SingleSearchSelect Class="min-w-150"
                                TItem="ManufacturerSearchResult"
                                TValue="Guid"
                                DataSource="@State.Value.Search.Filter.ManufacturerFilter.Manufacturers"
                                ValueName="@nameof(ManufacturerSearchResult.Id)"
                                LabelName="@nameof(ManufacturerSearchResult.Name)"
                                OnItemChanged="OnManufacturerChanged"
                                OnInputChanged="OnManufacturerInputChanged"
                                Placeholder="Manufacturer"
                                Value="@(State.Value.Search.Filter.ManufacturerFilter.SelectedManufacturer?.Id ?? Guid.Empty)"
                                SearchInput="@State.Value.Search.Filter.ManufacturerFilter.Input"
                                OnDropdownClosed="OnManufacturerDropdownClosed"
                                AllowClear="true">
            </SingleSearchSelect>
        </div>
    </div>
    <Button class="mt-3" @onclick="@OnLoadButtonClickedAsync" Disabled="@(!State.Value.Search.Filter.IsLoadButtonActive)">Load</Button>
</div>

@code {

    private void OnStoreChanged(ItemStore store)
    {
        Dispatcher.Dispatch(new SelectedStoreChangedAction(store));
    }

    private void OnItemCategoryChanged(ItemCategorySearchResult itemCategory)
    {
        Dispatcher.Dispatch(new SelectedItemCategoryChangedAction(itemCategory));
    }

    private void OnItemCategoryInputChanged(string input)
    {
        Dispatcher.Dispatch(new ItemCategoryInputChangedAction(input));
    }

    private void OnItemCategoryDropdownClosed()
    {
        Dispatcher.Dispatch(new ItemCategoryDropdownClosedAction());
    }

    private void OnManufacturerChanged(ManufacturerSearchResult itemCategory)
    {
        Dispatcher.Dispatch(new SelectedManufacturerChangedAction(itemCategory));
    }

    private void OnManufacturerInputChanged(string input)
    {
        Dispatcher.Dispatch(new ManufacturerInputChangedAction(input));
    }

    private void OnManufacturerDropdownClosed()
    {
        Dispatcher.Dispatch(new ManufacturerDropdownClosedAction());
    }

    private void OnLoadButtonClickedAsync()
    {
        Dispatcher.Dispatch(new LoadFilteredItemsAction());
    }

}
