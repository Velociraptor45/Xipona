@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@using Fluxor
@using Xipona.Frontend.Redux.Items.Actions.Editor
@using Xipona.Frontend.Redux.Items.States

@inject IState<ItemState> State
@inject IDispatcher Dispatcher
@inject NavigationManager NavigationManager

<Dropdown Placement="Placement.BottomRight" Trigger="@(new[] { Trigger.Click })">
    <Overlay>
        <Menu Selectable="false">
            <MenuItem Class="d-flex" OnClick="OnMergeItemButtonClicked">
                <i class="bi bi-sign-merge-right"></i>
                <span>Merge</span>
            </MenuItem>
            <MenuItem Class="d-flex" OnClick="OnOpenDeleteDialogButtonClicked" Style="color:#e74c3c">
                <i class="bi bi-trash mr-1"></i>
                <span>Delete</span>
            </MenuItem>
        </Menu>
    </Overlay>
    <ChildContent>
        <Button>
            <i class="bi bi-three-dots-vertical"></i>
        </Button>
    </ChildContent>
</Dropdown>

<DeleteItem></DeleteItem>

@code
{
    private void OnMergeItemButtonClicked()
    {
        var uri = NavigationManager.GetUriWithQueryParameters("/items/merge", new Dictionary<string, object>
        {
            { "itemId", State.Value.Editor.ItemId!.Value }
        });
        NavigationManager.NavigateTo(uri);
    }

    private void OnOpenDeleteDialogButtonClicked()
    {
        Dispatcher.Dispatch(new OpenDeleteItemDialogAction());
    }

}
