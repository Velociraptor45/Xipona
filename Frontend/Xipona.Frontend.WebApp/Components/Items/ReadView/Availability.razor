@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@using Fluxor
@using Xipona.Frontend.Redux.Items.States
@using Xipona.Frontend.WebApp.Services.Prices

@inject IPriceLabelService PriceLabelService

@{
    var store = GetStore(Model.StoreId);
    var section = GetSection(store, Model.DefaultSectionId);
    <div class="store-availability-card">
        <div class="store-info">
            <div class="store-name">@(store?.Name ?? "Unknown Store")</div>
            @if (section != null)
            {
                <div class="store-section">
                    <i class="bi bi-geo-alt mr-1"></i>@section.Name
                </div>
            }
        </div>
        <div class="store-price">
            @PriceLabelService.GetPriceLabel(Model.PricePerQuantity, Item.QuantityType)
        </div>
    </div>
}

@code {
    [Parameter] public EditedItem Item { get; set; }
    [Parameter] public EditedItemAvailability Model { get; set; }
    [Parameter] public ActiveStores Stores { get; set; }
    
    private ItemStore GetStore(Guid storeId)
    {
        return Stores.Stores.First(s => s.Id == storeId);
    }

    private ItemStoreSection GetSection(ItemStore? store, Guid sectionId)
    {
        return store?.Sections.First(s => s.Id == sectionId);
    }
}