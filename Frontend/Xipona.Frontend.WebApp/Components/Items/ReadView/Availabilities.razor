@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@using Xipona.Frontend.Redux.Items.States

<div class="availability-grid mt-2">
    @foreach (var availability in Models)
    {
        <Availability Model="availability" Item="Item" Stores="Stores"></Availability>
    }
</div>

@code {
    [Parameter] public ActiveStores Stores { get; set; }
    [Parameter] public IReadOnlyCollection<EditedItemAvailability> Models { get; set; }
    [Parameter] public EditedItem Item { get; set; }
}