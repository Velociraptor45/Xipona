@using Fluxor
@using Xipona.Frontend.Redux.Items.Actions.Merges
@using Xipona.Frontend.Redux.Items.States.Merges

@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@inject IDispatcher Dispatcher

<div>
    <div class="mb-4">
        <h1>Merge Items</h1>
        <hr/>
    </div>

    <Input TValue="string" Value="MergedItem.Name" OnInput="OnItemNameChanged" Placeholder="New item name ..."
           Class="mb-2 name-input">
    </Input>

    <h2 class="font-weight-bold mt-2">Types</h2>

    @foreach (var type in MergedItem.Types)
    {
        <div class="mb-3">
            <ItemTypeMerger MergedItemType="type"></ItemTypeMerger>
        </div>
    }
    <Button Class="mt-2 d-flex ml-auto" OnClick="OnSaveButtonClicked" Type="@ButtonType.Primary">Save</Button>
</div>

@code
{
    [Parameter]
    public required MergedItem MergedItem { get; set; }

    private void OnItemNameChanged(ChangeEventArgs args)
    {
        Dispatcher.Dispatch(new ItemNameChangedAction(args.Value?.ToString() ?? string.Empty));
    }

    private void OnSaveButtonClicked()
    {
        Dispatcher.Dispatch(new MergeItemsAction());
    }
}
