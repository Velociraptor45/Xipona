@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@using Fluxor
@using Xipona.Frontend.Redux.Manufacturers.States

@inject IState<ManufacturerState> State

@if (State.Value.Editor.ReadOnlyManufacturer is not null)
{
    var manufacturer = State.Value.Editor.ReadOnlyManufacturer;

    <div class="pt-2 manufacturer-read-view">
        <ManufacturerHeader Manufacturer="manufacturer"></ManufacturerHeader>
        <ManufacturerProperties Manufacturer="manufacturer"></ManufacturerProperties>
    </div>
}