@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@using Fluxor
@using Xipona.Frontend.Redux.ShoppingList.Actions.ShoppingListDiscounts
@using Xipona.Frontend.Redux.ShoppingList.States
@using Xipona.Frontend.WebApp.Services.Discounts
@using Xipona.Frontend.WebApp.Components.Index.Discounts

@inject IState<ShoppingListState> State
@inject IDispatcher Dispatcher
@inject IDiscountLabelService LabelService

<Modal Title="Manage Shopping List Discounts"
       Visible="@State.Value.ShoppingListDiscountDialog.IsOpen"
       OnCancel="@CloseModal"
       ConfirmLoading="@State.Value.ShoppingListDiscountDialog.IsSaving"
       Footer="GetFooter()">
       
    <div class="d-flex">
        <Input TValue="decimal?" Value="@State.Value.ShoppingListDiscountDialog.DiscountValue"
               Placeholder="Discount" ValueChanged="OnDiscountChanged" Class="discount-input"></Input>
        <EnumSelect TEnum="ShoppingListDiscountType" ValueChanged="OnDiscountTypeChanged"
                    ItemLabel="LabelService.GetLabel" Value="@State.Value.ShoppingListDiscountDialog.Type"
                    Class="discount-type-select" Style=""> <!-- Do NOT remove this empty style here - this eliminates the default 'width: 100%' -->
        </EnumSelect>
        <Button Class="ml-auto"
                OnClick="OnAddButtonClicked"
                @key="@("submit")"
                Type="@ButtonType.Primary"
                Loading="@State.Value.ShoppingListDiscountDialog.IsSaving"
                Disabled="@(State.Value.ShoppingListDiscountDialog.DiscountValue <= 0)">
            Add
        </Button>
    </div>
    
    @if (State.Value.ShoppingList!.Discounts.Count > 0)
    {
        <hr class="my-3" />
        <h3 class="existing-discounts-headline mb-3">Existing Shopping List Discounts</h3>
        <div>
            @foreach (var discount in State.Value.ShoppingList.Discounts)
            {
                <ExistingShoppingListDiscount Model="discount"></ExistingShoppingListDiscount>
            }
        </div>
    }
</Modal>

@code {

    private void OnDiscountChanged(decimal? discount)
    {
        Dispatcher.Dispatch(new DiscountValueChangedAction(discount ?? 0));
    }

    private void OnDiscountTypeChanged(ShoppingListDiscountType type)
    {
        Dispatcher.Dispatch(new DiscountTypeChangedAction(type));
    }

    private void OnAddButtonClicked()
    {
        Dispatcher.Dispatch(new SaveDiscountAction());
    }

    private void CloseModal()
    {
        Dispatcher.Dispatch(new CloseDiscountDialogAction());
    }

    private RenderFragment GetFooter()
    {
        return @<Template></Template>;
    }
}
