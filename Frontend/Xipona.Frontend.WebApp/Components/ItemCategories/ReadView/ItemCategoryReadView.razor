@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@using Fluxor
@using Xipona.Frontend.Redux.ItemCategories.States

@inject IState<ItemCategoryState> State

@if (State.Value.Editor.ReadOnlyItemCategory is not null)
{
    var itemCategory = State.Value.Editor.ReadOnlyItemCategory;

    <div class="pt-2 item-category-read-view">
        <ItemCategoryHeader ItemCategory="itemCategory"></ItemCategoryHeader>
        <ItemCategoryProperties ItemCategory="itemCategory"></ItemCategoryProperties>
    </div>
}